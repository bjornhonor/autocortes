# Copie para .env e preencha conforme cada fase pedir. O .env nunca vai para o git.

# Juiz dos cortes pela sua assinatura do Claude (Pro/Max): rode `claude setup-token` num
# terminal, autorize com a conta que vai usar e cole o token aqui. Sem ele, vale o login
# do Claude Code nesta máquina, se houver. Chaves ANTHROPIC_* são ignoradas pelo juiz.
CLAUDE_CODE_OAUTH_TOKEN=

# YouTube: JSON do cliente OAuth "App para computador"
YOUTUBE_CLIENT_SECRETS=secrets/youtube_client_secret.json

# Instagram: conta profissional
INSTAGRAM_USER_ID=
INSTAGRAM_ACCESS_TOKEN=

# TikTok: Content Posting API
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=

# Twitch, opcional: clipes criados pelos viewers viram picos (o sinal mais forte).
# Registre um app em https://dev.twitch.tv/console (categoria "Application Integration",
# OAuth Redirect URL http://localhost) e copie o Client ID e um Client Secret novo.
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
