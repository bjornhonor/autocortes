# Copie para .env e preencha conforme cada fase pedir. O .env nunca vai para o git.

# Claude: detecção de momentos e texto dos posts (fase 2)
ANTHROPIC_API_KEY=

# YouTube: JSON do cliente OAuth "App para computador" (fase 4)
YOUTUBE_CLIENT_SECRETS=secrets/youtube_client_secret.json

# Instagram: conta profissional (fase 4)
INSTAGRAM_USER_ID=
INSTAGRAM_ACCESS_TOKEN=

# TikTok: Content Posting API (fase 4)
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=

# Twitch, opcional: clipes criados pelos viewers como sinal (fase 3)
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
